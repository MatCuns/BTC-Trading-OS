# Copy through START_PAPER.bat; never commit the generated .env.
BTC_DATABASE_URL=postgresql+psycopg://btc_app:LOCAL_PASSWORD@127.0.0.1:5432/btc_quant
BTC_DATA_ROOT=C:/BTCQuantData
BTC_BACKUP_ROOT=E:/BTCQuantBackup
BTC_FEED_MODE=okx
# No silent fallback. Set fixture explicitly for an offline simulation.
BTC_STRATEGY_ENABLED=false
BTC_MAX_LEVERAGE=1
BTC_TRADE_LOSS_BUDGET=0.005
BTC_DAILY_LOSS=0.02
BTC_MAX_DRAWDOWN=0.10
BTC_TAKER_FEE=0.0005
BTC_MAKER_FEE=0.0002
BTC_SLIPPAGE_BPS=2
BTC_INITIAL_CASH=10000
